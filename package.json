{
  "name": "nousgent-ai-platform",
  "version": "1.19.0",
  "private": true,
  "description": "nousgent.ai & ia.nousgent.ai — NOUSGENT Flagship Gamified Mission Control & Autonomous M2M Swarm Plane for Open-Source Bounded ASI on the Chia Blockchain & DIG Network",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "docs:generate": "npm --prefix packages/dolfactory run docs:generate && npm --prefix packages/dthalamus run docs:generate && npm --prefix packages/dbrain run docs:generate",
    "docs:check": "npm --prefix packages/dolfactory run docs:check && npm --prefix packages/dthalamus run docs:check && npm --prefix packages/dbrain run docs:check",
    "dashboards:generate": "node scripts/generate-grafana-dashboards.mjs",
    "build": "tsc --noEmit && vite build",
    "build:dapp": "node scripts/build-dapp.mjs",
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "version:status": "node scripts/version.mjs status",
    "version:verify": "node scripts/version.mjs status --verify",
    "version:sync": "node scripts/version.mjs sync",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "test:unit": "node --no-warnings=ExperimentalWarning --test --experimental-test-coverage --test-coverage-include=\"lib/*.js\" --test-coverage-include=\"lib/modules/*.js\" --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/nousgent-core.test.js",
    "test:coverage": "npm run test:unit",
    "test": "bash deploy/scripts/test.sh",
    "deploy": "bash deploy/scripts/deploy.sh",
    "scan": "bash deploy/scripts/scan.sh"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "onnxruntime-web": "^1.31.1",
    "phonemizer": "^1.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
